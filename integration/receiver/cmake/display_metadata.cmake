# Display-only Git metadata. Never embed a local checkout path or credentials.
function(sanitize_display_metadata)
  string(STRIP "${GIT_REPO_URL}" url)
  if(url MATCHES "^git@github\\.com:(.+)$")
    set(url "https://github.com/${CMAKE_MATCH_1}")
  elseif(url MATCHES "^ssh://git@github\\.com/(.+)$")
    set(url "https://github.com/${CMAKE_MATCH_1}")
  endif()
  string(REGEX REPLACE "\\.git$" "" url "${url}")
  if(NOT url MATCHES "^https://[A-Za-z0-9.-]+(:[0-9]+)?/[A-Za-z0-9_./~+-]+$")
    set(url "unknown")
  endif()
  set(GIT_REPO_URL "${url}" PARENT_SCOPE)
  foreach(name GIT_BRANCH GIT_AUTHOR)
    string(STRIP "${${name}}" value)
    if(value STREQUAL "")
      set(value "unknown")
    endif()
    # Escape C string literals and avoid CMake list/newline separators.
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REGEX REPLACE "[;\r\n]" " " value "${value}")
    set(${name} "${value}" PARENT_SCOPE)
  endforeach()
endfunction()
